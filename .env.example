# Google Gemini API — для генерации постов
# Получить: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram Bot — токен от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel — @username публичного канала или числовой ID приватного
# Пример публичного:  @my_land_channel
# Пример приватного:  -1001234567890
CHANNEL_ID=@your_channel_username_here

# --- Ручной запуск через trigger_bot.py ---

# Ваш числовой Telegram ID (узнать: написать @userinfobot)
# Только этот ID сможет отправлять команды боту
OWNER_CHAT_ID=123456789

# GitHub Personal Access Token для запуска Actions вручную
# Создать: GitHub → Settings → Developer settings → Personal access tokens → Fine-grained
# Нужные права: Actions → Read and write (или classic token со scope: workflow)
GH_PAT=github_pat_your_token_here

# Репозиторий и ветка (менять не нужно, если стандартный форк)
GITHUB_REPO=Kedros64/telegram-channel-land-water
GITHUB_BRANCH=master
