# Claude AI (Anthropic) — для генерации постов
# Получить: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Telegram Bot — токен от @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel — @username публичного канала или числовой ID приватного
# Пример публичного:  @my_land_channel
# Пример приватного:  -1001234567890
CHANNEL_ID=@your_channel_username_here
